# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PDF region retype worker (backend only)
# Set true only for local UI smoke tests; it never calls an AI service.
ANTIGRAVITY_MOCK=false
# Python executable used by the PDF workers
PYTHON_BIN=python

# Retype backend: 9router (default) or sdk (legacy Google Antigravity SDK)
ANTIGRAVITY_BACKEND=9router
# Local 9router OpenAI-compatible API.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=ag/gemini-3.7-flash-high
NINE_ROUTER_TIMEOUT_SECONDS=300
# Required when 9router returns 401 Missing API key (as in the current local instance).
NINE_ROUTER_API_KEY=

# Legacy SDK configuration, used only with ANTIGRAVITY_BACKEND=sdk
# python -m pip install google-antigravity==0.1.15
GEMINI_API_KEY=
